# ==============================================================================
# Solar Store Frontend - Production Environment Template (.env.production)
# ==============================================================================
# Configure these variables in your Production Vercel project.

NODE_ENV="production"

# Where the Live Production NestJS API lives
API_URL="https://api.solarstore.example.com"

# --- Supabase Auth (Production Project) ---
# Found in: Production Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<prod_ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<prod_supabase_anon_key>"

# NOTE: NEXT_PUBLIC_* variables are inlined at build time.
# If updated, a fresh deployment without build cache is required.
