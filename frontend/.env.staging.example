# ==============================================================================
# Solar Store Frontend - Staging Environment Template (.env.staging)
# ==============================================================================
# Configure these variables in your Staging Vercel project / preview deployment.

NODE_ENV="staging"

# Where the Staging NestJS API lives
API_URL="https://staging-api.solarstore.example.com"

# --- Supabase Auth (Staging Project) ---
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<staging_ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<staging_supabase_anon_key>"

# NOTE: NEXT_PUBLIC_* variables are inlined at build time.
# If updated, a fresh deployment without build cache is required.
