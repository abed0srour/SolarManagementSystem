# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Where the NestJS API lives.
#
# The app calls "/api/..." on its own origin and next.config.ts rewrites that to
# this host. Keeping it same-origin means no CORS round-trip and no API URL
# baked into the browser bundle.
#
# Local:      http://localhost:3000
# Production: https://<your-backend-project>.vercel.app
API_URL="http://localhost:3000"

# --- Supabase Auth ---
# Identity is handled by Supabase directly from the browser, so these two are
# public by design and safe to ship in the bundle. The anon key can do nothing
# that Row Level Security does not allow.
#
# Local stack: `supabase start` prints both.
# Hosted:      Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# NEVER put SUPABASE_SERVICE_ROLE_KEY here. Anything prefixed NEXT_PUBLIC_ is
# compiled into the JavaScript every visitor downloads, and the service role key
# bypasses every policy in the database. It belongs in backend/.env only.
