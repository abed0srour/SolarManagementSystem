# Copy this file to .env.local for local development.

NODE_ENV="development"

# URL of the local NestJS API.
# Next.js rewrites "/api/:path*" to "${API_URL}/api/:path*"
API_URL="http://localhost:3000"

# --- Supabase Auth (Local Dev Stack) ---
# Values output from `supabase start`
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# SECURITY WARNING:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY here.
# Anything with NEXT_PUBLIC_ is compiled into the client-side JavaScript bundle.
