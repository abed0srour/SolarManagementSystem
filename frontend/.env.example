# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Where the NestJS API lives.
#
# The app calls "/api/..." on its own origin and next.config.ts rewrites that to
# this host. Keeping it same-origin means no CORS round-trip and no API URL
# baked into the browser bundle.
#
# Local:      http://localhost:3000
# Production: https://<your-backend-project>.vercel.app
API_URL="http://localhost:3000"
