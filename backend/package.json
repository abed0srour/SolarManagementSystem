{
  "name": "solar-store-backend",
  "version": "1.0.0",
  "description": "Solar Store Management System API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "superadmin:create": "node scripts/create-super-admin.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "prisma:diff": "prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-url $DIRECT_URL --script",
    "users:migrate": "node scripts/migrate-users-to-supabase.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
