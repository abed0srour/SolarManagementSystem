generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Users, Auth & Audit ============

enum Role {
  ADMIN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(ADMIN)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  loginHistory     LoginHistory[]
  auditLogs        AuditLog[]
  priceChanges     PriceHistory[]
  stockMovements   StockMovement[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  payments         Payment[]
  refundsCreated   Refund[]             @relation("RefundCreatedBy")
  refundsApproved  Refund[]             @relation("RefundApprovedBy")
  warrantyClaims   WarrantyClaim[]
  serviceJobs      ServiceJob[]
  goodsReceipts    GoodsReceipt[]
  attachments      Attachment[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Attachment {
  id           String   @id @default(uuid())
  entity       String // e.g. "Product", "Client", "WarrantyClaim", "ServiceJob", "Supplier", "Company"
  entityId     String
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
}

// ============ Catalog ============

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  subCategories SubCategory[]
}

model SubCategory {
  id            String                @id @default(uuid())
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  deletedAt     DateTime?
  attributeDefs AttributeDefinition[]
  products      Product[]

  @@unique([categoryId, name])
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model AttributeDefinition {
  id            String        @id @default(uuid())
  subCategoryId String
  subCategory   SubCategory   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  name          String // machine key, e.g. "wattage"
  label         String // display label, e.g. "Wattage"
  type          AttributeType @default(TEXT)
  unit          String? // e.g. "W", "kWh", "V"
  options       Json? // for SELECT type: ["On-grid","Off-grid","Hybrid"]
  required      Boolean       @default(false)
  sortOrder     Int           @default(0)

  @@unique([subCategoryId, name])
}

model Product {
  id                        String    @id @default(uuid())
  sku                       String    @unique
  name                      String
  brand                     String?
  model                     String?
  subCategoryId             String
  subCategory               SubCategory @relation(fields: [subCategoryId], references: [id])
  attributes                Json      @default("{}") // flexible technical specs per sub-category
  costPrice                 Decimal   @db.Decimal(12, 2)
  salePrice                 Decimal   @db.Decimal(12, 2)
  priceUpdatedAt            DateTime  @default(now())
  taxRatePct                Decimal   @default(0) @db.Decimal(5, 2)
  trackSerials              Boolean   @default(true)
  lowStockThreshold         Int       @default(5)
  warrantyMonths            Int? // product warranty
  performanceWarrantyMonths Int? // panels: output/performance warranty
  shelfLifeMonths           Int? // lead-acid batteries
  barcode                   String?
  imageUrl                  String?
  notes                     String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  deletedAt                 DateTime?

  priceHistory       PriceHistory[]
  stockLevels        StockLevel[]
  units              ProductUnit[]
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  returnItems        ReturnItem[]
  warrantyClaims     WarrantyClaim[]
  compatibleFrom     CompatibilityLink[] @relation("CompatFrom")
  compatibleTo       CompatibilityLink[] @relation("CompatTo")

  @@index([name])
  @@index([brand])
  @@index([subCategoryId])
}

model PriceHistory {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldCostPrice Decimal? @db.Decimal(12, 2)
  newCostPrice Decimal? @db.Decimal(12, 2)
  oldSalePrice Decimal? @db.Decimal(12, 2)
  newSalePrice Decimal? @db.Decimal(12, 2)
  reason       String?
  changedById  String?
  changedBy    User?    @relation(fields: [changedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
}

model CompatibilityLink {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation("CompatFrom", fields: [productId], references: [id], onDelete: Cascade)
  compatibleWithId String
  compatibleWith   Product @relation("CompatTo", fields: [compatibleWithId], references: [id], onDelete: Cascade)
  note             String?

  @@unique([productId, compatibleWithId])
}

// ============ Inventory ============

model Warehouse {
  id        String    @id @default(uuid())
  name      String    @unique
  address   String?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  stockLevels    StockLevel[]
  units          ProductUnit[]
  movementsFrom  StockMovement[] @relation("MoveFrom")
  movementsTo    StockMovement[] @relation("MoveTo")
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

model StockLevel {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0)
  reserved    Int       @default(0)

  @@unique([productId, warehouseId])
}

enum UnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  RETURNED_TO_SUPPLIER
}

model ProductUnit {
  id                         String     @id @default(uuid())
  productId                  String
  product                    Product    @relation(fields: [productId], references: [id])
  serialNumber               String     @unique
  status                     UnitStatus @default(IN_STOCK)
  warehouseId                String?
  warehouse                  Warehouse? @relation(fields: [warehouseId], references: [id])
  manufactureDate            DateTime?
  purchaseOrderId            String?
  purchaseOrder              PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId               String?
  salesOrder                 SalesOrder? @relation(fields: [salesOrderId], references: [id])
  invoiceId                  String?
  invoice                    Invoice?   @relation(fields: [invoiceId], references: [id])
  warrantyStartDate          DateTime?
  warrantyEndDate            DateTime?
  performanceWarrantyEndDate DateTime?
  createdAt                  DateTime   @default(now())

  warrantyClaims WarrantyClaim[]

  @@index([productId, status])
  @@index([warrantyEndDate])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation("MoveFrom", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?   @relation("MoveTo", fields: [toWarehouseId], references: [id])
  type          MovementType
  quantity      Int
  reason        String?
  refType       String? // e.g. "SalesOrder", "PurchaseOrder", "Refund"
  refId         String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
}

// ============ Parties ============

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientTier {
  RETAIL
  WHOLESALE
  INSTALLER
}

model Client {
  id          String     @id @default(uuid())
  name        String
  type        ClientType @default(INDIVIDUAL)
  tier        ClientTier @default(RETAIL)
  email       String?
  phone       String?
  taxNumber   String?
  creditLimit Decimal    @default(0) @db.Decimal(12, 2)
  storeCredit Decimal    @default(0) @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  addresses      ClientAddress[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  warrantyClaims WarrantyClaim[]
  serviceJobs    ServiceJob[]

  @@index([name])
}

model ClientAddress {
  id             String  @id @default(uuid())
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label          String  @default("Main")
  line1          String
  city           String?
  isBilling      Boolean @default(true)
  isInstallation Boolean @default(false)
}

model Supplier {
  id           String    @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  leadTimeDays Int?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  products        SupplierProduct[]
  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[]
  payments        Payment[]
  supplierReturns SupplierReturn[]

  @@index([name])
}

model SupplierProduct {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierPrice Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, productId])
}

// ============ Sales Cycle ============

enum DiscountType {
  PERCENT
  FIXED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id            String          @id @default(uuid())
  number        String          @unique
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?
  discountType  DiscountType?
  discountValue Decimal         @default(0) @db.Decimal(12, 2)
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@index([status])
}

model QuotationItem {
  id            String        @id @default(uuid())
  quotationId   String
  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  description   String?
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  taxRatePct    Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id            String           @id @default(uuid())
  number        String           @unique
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  quotationId   String?
  quotation     Quotation?       @relation(fields: [quotationId], references: [id])
  warehouseId   String
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  status        SalesOrderStatus @default(PENDING)
  orderDate     DateTime         @default(now())
  discountType  DiscountType?
  discountValue Decimal          @default(0) @db.Decimal(12, 2)
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal          @default(0) @db.Decimal(12, 2)
  shippingFee   Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?

  items       SalesOrderItem[]
  invoices    Invoice[]
  serviceJobs ServiceJob[]
  units       ProductUnit[]

  @@index([status])
  @@index([clientId])
}

model SalesOrderItem {
  id            String        @id @default(uuid())
  salesOrderId  String
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  description   String?
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  taxRatePct    Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)
  deliveredQty  Int           @default(0)
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  number           String              @unique
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId      String
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  currency         String              @default("USD")
  exchangeRate     Decimal             @default(1) @db.Decimal(12, 6)
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  units         ProductUnit[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
  lineTotal       Decimal       @db.Decimal(12, 2)
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?
  discrepancies   String?
  items           Json // [{ productId, quantity, serialNumbers: [] }]
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
}

// ============ Invoicing & Payments ============

enum InvoiceType {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String         @id @default(uuid())
  number          String         @unique
  type            InvoiceType    @default(SALE)
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status          InvoiceStatus  @default(UNPAID)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  currency        String         @default("USD")
  exchangeRate    Decimal        @default(1) @db.Decimal(12, 6)
  discountType    DiscountType?
  discountValue   Decimal        @default(0) @db.Decimal(12, 2)
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?

  items          InvoiceItem[]
  payments       Payment[]
  schedules      PaymentSchedule[]
  refunds        Refund[]
  units          ProductUnit[]
  warrantyClaims WarrantyClaim[]

  @@index([status])
  @@index([type, issueDate])
  @@index([clientId])
  @@index([supplierId])
}

model InvoiceItem {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2) // price snapshot at time of transaction
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  taxRatePct    Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  MOBILE
  STORE_CREDIT
}

model Payment {
  id           String           @id @default(uuid())
  number       String           @unique
  direction    PaymentDirection
  invoiceId    String?
  invoice      Invoice?         @relation(fields: [invoiceId], references: [id])
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id])
  supplierId   String?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  scheduleId   String?
  schedule     PaymentSchedule? @relation(fields: [scheduleId], references: [id])
  method       PaymentMethod
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("USD")
  exchangeRate Decimal          @default(1) @db.Decimal(12, 6)
  paymentDate  DateTime         @default(now())
  reference    String?
  notes        String?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  @@index([paymentDate])
  @@index([direction])
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentSchedule {
  id            String         @id @default(uuid())
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Decimal        @db.Decimal(12, 2)
  status        ScheduleStatus @default(PENDING)
  paidAt        DateTime?

  payments Payment[]

  @@unique([invoiceId, installmentNo])
  @@index([status, dueDate])
}

// ============ Refunds & Returns ============

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundReason {
  DEFECTIVE
  WRONG_ITEM
  CHANGE_OF_MIND
  OTHER
}

enum RefundMethod {
  CASH
  STORE_CREDIT
  EXCHANGE
}

model Refund {
  id           String       @id @default(uuid())
  number       String       @unique
  invoiceId    String
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  status       RefundStatus @default(PENDING)
  reason       RefundReason @default(OTHER)
  method       RefundMethod @default(CASH)
  totalAmount  Decimal      @default(0) @db.Decimal(12, 2)
  notes        String?
  createdById  String
  createdBy    User         @relation("RefundCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?        @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  items ReturnItem[]

  @@index([status])
}

enum ItemCondition {
  RESELLABLE
  DAMAGED
}

model ReturnItem {
  id            String        @id @default(uuid())
  refundId      String
  refund        Refund        @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  condition     ItemCondition @default(RESELLABLE)
  serialNumbers Json?
}

enum SupplierReturnStatus {
  PENDING
  SENT
  CREDITED
  REPLACED
  CLOSED
}

model SupplierReturn {
  id            String               @id @default(uuid())
  number        String               @unique
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  status        SupplierReturnStatus @default(PENDING)
  creditNoteRef String?
  notes         String?
  items         Json // [{ productId, quantity, serialNumbers, reason }]
  createdAt     DateTime             @default(now())
  deletedAt     DateTime?
}

// ============ Warranty & Service ============

enum ClaimStatus {
  OPEN
  SENT_TO_SUPPLIER
  RESOLVED
  REPLACED
  REJECTED
}

model WarrantyClaim {
  id            String       @id @default(uuid())
  number        String       @unique
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  serialNumber  String?
  issue         String
  status        ClaimStatus  @default(OPEN)
  resolution    String?
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  deletedAt     DateTime?

  @@index([status])
}

enum ServiceJobType {
  INSTALLATION
  MAINTENANCE
  SURVEY
  REPAIR
}

enum ServiceJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceJob {
  id             String           @id @default(uuid())
  number         String           @unique
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  salesOrderId   String?
  salesOrder     SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  type           ServiceJobType   @default(INSTALLATION)
  status         ServiceJobStatus @default(SCHEDULED)
  technicianName String?
  scheduledDate  DateTime?
  completedDate  DateTime?
  notes          String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?

  @@index([status, scheduledDate])
}

// ============ Notifications & Settings ============

enum NotificationType {
  LOW_STOCK
  PAYMENT_DUE
  PAYMENT_OVERDUE
  WARRANTY_EXPIRING
  QUOTATION_EXPIRING
  WARRANTY_CLAIM_OPENED
  SHELF_LIFE_ALERT
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  entity    String?
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
}

model Setting {
  key   String @id
  value Json
}

model NumberSequence {
  id         String @id @default(uuid())
  entity     String @unique // INVOICE, QUOTATION, SALES_ORDER, PURCHASE_ORDER, PAYMENT, REFUND, CLAIM, JOB, SUPPLIER_RETURN
  prefix     String
  nextNumber Int    @default(1)
  padding    Int    @default(5)
}
