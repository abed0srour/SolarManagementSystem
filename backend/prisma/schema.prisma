generator client {
  provider        = "prisma-client-js"
  // relationJoins: load included relations via a single SQL JOIN instead of
  // one query per relation — critical over a high-latency remote database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ Users, Auth & Audit ============

enum Role {
  ADMIN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(ADMIN)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  refreshTokens     RefreshToken[]
  resetTokens       PasswordResetToken[]
  verificationCodes VerificationCode[]
  loginHistory     LoginHistory[]
  auditLogs        AuditLog[]
  priceChanges     PriceHistory[]
  stockMovements   StockMovement[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  salesOrdersClaimed SalesOrder[]       @relation("SalesOrderClaimedBy")
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  payments         Payment[]
  refundsCreated   Refund[]             @relation("RefundCreatedBy")
  refundsApproved  Refund[]             @relation("RefundApprovedBy")
  warrantyClaims   WarrantyClaim[]
  serviceJobs      ServiceJob[]
  goodsReceipts    GoodsReceipt[]
  attachments      Attachment[]
  installations    Installation[]
  expenses         Expense[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Short-lived numeric codes emailed to confirm sensitive account changes
model VerificationCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // EMAIL_CHANGE | PASSWORD_CHANGE
  newEmail  String?
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Attachment {
  id           String   @id @default(uuid())
  entity       String // e.g. "Product", "Client", "WarrantyClaim", "ServiceJob", "Supplier", "Company"
  entityId     String
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
}

// ============ Catalog ============

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  subCategories SubCategory[]
}

model SubCategory {
  id            String                @id @default(uuid())
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  deletedAt     DateTime?
  attributeDefs AttributeDefinition[]
  products      Product[]

  @@unique([categoryId, name])
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model AttributeDefinition {
  id            String        @id @default(uuid())
  subCategoryId String
  subCategory   SubCategory   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  name          String // machine key, e.g. "wattage"
  label         String // display label, e.g. "Wattage"
  type          AttributeType @default(TEXT)
  unit          String? // e.g. "W", "kWh", "V"
  options       Json? // for SELECT type: ["On-grid","Off-grid","Hybrid"]
  required      Boolean       @default(false)
  sortOrder     Int           @default(0)

  @@unique([subCategoryId, name])
}

model Product {
  id                        String    @id @default(uuid())
  sku                       String    @unique
  name                      String
  brand                     String?
  model                     String?
  subCategoryId             String
  subCategory               SubCategory @relation(fields: [subCategoryId], references: [id])
  attributes                Json      @default("{}") // flexible technical specs per sub-category
  costPrice                 Decimal   @db.Decimal(12, 2)
  salePrice                 Decimal   @db.Decimal(12, 2)
  priceUpdatedAt            DateTime  @default(now())
  // Services (installation, delivery…) are sellable but carry no stock
  isService                 Boolean   @default(false)
  trackSerials              Boolean   @default(true)
  lowStockThreshold         Int       @default(5)
  warrantyMonths            Int? // product warranty
  performanceWarrantyMonths Int? // panels: output/performance warranty
  shelfLifeMonths           Int? // lead-acid batteries
  barcode                   String?
  imageUrl                  String?
  notes                     String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  deletedAt                 DateTime?

  priceHistory       PriceHistory[]
  stockLevels        StockLevel[]
  units              ProductUnit[]
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  returnItems        ReturnItem[]
  warrantyClaims     WarrantyClaim[]
  compatibleFrom     CompatibilityLink[] @relation("CompatFrom")
  compatibleTo       CompatibilityLink[] @relation("CompatTo")

  @@index([name])
  @@index([brand])
  @@index([subCategoryId])
}

model PriceHistory {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldCostPrice Decimal? @db.Decimal(12, 2)
  newCostPrice Decimal? @db.Decimal(12, 2)
  oldSalePrice Decimal? @db.Decimal(12, 2)
  newSalePrice Decimal? @db.Decimal(12, 2)
  reason       String?
  changedById  String?
  changedBy    User?    @relation(fields: [changedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
}

model CompatibilityLink {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation("CompatFrom", fields: [productId], references: [id], onDelete: Cascade)
  compatibleWithId String
  compatibleWith   Product @relation("CompatTo", fields: [compatibleWithId], references: [id], onDelete: Cascade)
  note             String?

  @@unique([productId, compatibleWithId])
}

// ============ Inventory ============

model Warehouse {
  id        String    @id @default(uuid())
  name      String    @unique
  address   String?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  stockLevels    StockLevel[]
  units          ProductUnit[]
  movementsFrom  StockMovement[] @relation("MoveFrom")
  movementsTo    StockMovement[] @relation("MoveTo")
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

model StockLevel {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  reserved    Int       @default(0)

  @@unique([productId, warehouseId])
}

enum UnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  RETURNED_TO_SUPPLIER
}

model ProductUnit {
  id                         String     @id @default(uuid())
  productId                  String
  product                    Product    @relation(fields: [productId], references: [id])
  serialNumber               String     @unique
  status                     UnitStatus @default(IN_STOCK)
  warehouseId                String?
  warehouse                  Warehouse? @relation(fields: [warehouseId], references: [id])
  manufactureDate            DateTime?
  purchaseOrderId            String?
  purchaseOrder              PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId               String?
  salesOrder                 SalesOrder? @relation(fields: [salesOrderId], references: [id])
  invoiceId                  String?
  invoice                    Invoice?   @relation(fields: [invoiceId], references: [id])
  warrantyStartDate          DateTime?
  warrantyEndDate            DateTime?
  performanceWarrantyEndDate DateTime?
  createdAt                  DateTime   @default(now())

  warrantyClaims WarrantyClaim[]

  @@index([productId, status])
  @@index([warrantyEndDate])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation("MoveFrom", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?   @relation("MoveTo", fields: [toWarehouseId], references: [id])
  type          MovementType
  quantity      Decimal  @db.Decimal(12, 3)
  reason        String?
  refType       String? // e.g. "SalesOrder", "PurchaseOrder", "Refund"
  refId         String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
}

// ============ Parties ============

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientTier {
  RETAIL
  WHOLESALE
  INSTALLER
}

model Client {
  id          String     @id @default(uuid())
  name        String
  type        ClientType @default(INDIVIDUAL)
  tier        ClientTier @default(RETAIL)
  email       String?
  phone       String?
  taxNumber   String?
  creditLimit Decimal    @default(0) @db.Decimal(12, 2)
  storeCredit Decimal    @default(0) @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  addresses      ClientAddress[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  warrantyClaims WarrantyClaim[]
  serviceJobs    ServiceJob[]
  installations  Installation[]

  @@index([name])
}

model ClientAddress {
  id             String  @id @default(uuid())
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label          String  @default("Main")
  line1          String
  city           String?
  isBilling      Boolean @default(true)
  isInstallation Boolean @default(false)
}

model Supplier {
  id           String    @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  leadTimeDays Int?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  products        SupplierProduct[]
  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[]
  payments        Payment[]
  supplierReturns SupplierReturn[]

  @@index([name])
}

model SupplierProduct {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierPrice Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, productId])
}

// ============ Sales Cycle ============

enum DiscountType {
  PERCENT
  FIXED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id            String          @id @default(uuid())
  number        String          @unique
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?
  discountType  DiscountType?
  discountValue Decimal         @default(0) @db.Decimal(12, 2)
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@index([status])
}

model QuotationItem {
  id            String        @id @default(uuid())
  quotationId   String
  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String?
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)

  isComposite   Boolean       @default(false)
  autoPrice     Boolean       @default(true)
  parentItemId  String?
  parentItem    QuotationItem?  @relation("QuotationItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems      QuotationItem[] @relation("QuotationItemTree")

  @@index([parentItemId])
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id            String           @id @default(uuid())
  number        String           @unique
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  quotationId   String?
  quotation     Quotation?       @relation(fields: [quotationId], references: [id])
  warehouseId   String
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  status        SalesOrderStatus @default(PENDING)
  orderDate     DateTime         @default(now())
  discountType  DiscountType?
  discountValue Decimal          @default(0) @db.Decimal(12, 2)
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  shippingFee   Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  notes         String?
  /// Print bundle contents on the customer's invoice. Off by default: the
  /// customer sees one package line, the warehouse still sees every component.
  showSubItemsOnInvoice Boolean   @default(false)

  /// Short code printed on the POS receipt. The customer brings it to the
  /// warehouse, where it is the only thing needed to find and release the goods.
  pickupCode    String?          @unique
  /// Set the moment the warehouse hands the goods over. Also the guard that
  /// stops one receipt being claimed twice.
  claimedAt     DateTime?
  claimedById   String?
  claimedBy     User?            @relation("SalesOrderClaimedBy", fields: [claimedById], references: [id])
  claimNotes    String?

  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?

  items         SalesOrderItem[]
  invoices      Invoice[]
  serviceJobs   ServiceJob[]
  units         ProductUnit[]
  installations Installation[]

  @@index([status])
  @@index([clientId])
}

model SalesOrderItem {
  id            String        @id @default(uuid())
  salesOrderId  String
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  // Null on composite bundle headers and on descriptive sub-items, which are
  // typed by hand rather than picked from the catalogue.
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String?
  // Decimal so metered sub-items can carry 12.5 m of cable. Catalogue lines
  // still hold whole numbers — they are the only ones that move stock.
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  /// Unit of measure for sub-items: pcs, set, m, ft…
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)
  deliveredQty  Int           @default(0)

  /// True on a bundle header. Its own price is the sum of its sub-items unless overridden.
  isComposite   Boolean       @default(false)
  /// When true the bundle price is recomputed from its sub-items on every save.
  autoPrice     Boolean       @default(true)
  parentItemId  String?
  parentItem    SalesOrderItem?  @relation("SalesOrderItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems      SalesOrderItem[] @relation("SalesOrderItemTree")

  @@index([parentItemId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  number           String              @unique
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId      String
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  currency         String              @default("USD")
  exchangeRate     Decimal             @default(1) @db.Decimal(12, 6)
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  hasDeliveryCost  Boolean             @default(false)
  deliveryCost     Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  units         ProductUnit[]
  payments      Payment[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
  lineTotal       Decimal       @db.Decimal(12, 2)
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?
  discrepancies   String?
  items           Json // [{ productId, quantity, serialNumbers: [] }]
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
}

// ============ Invoicing & Payments ============

enum InvoiceType {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String         @id @default(uuid())
  number          String         @unique
  type            InvoiceType    @default(SALE)
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status          InvoiceStatus  @default(UNPAID)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  currency        String         @default("USD")
  exchangeRate    Decimal        @default(1) @db.Decimal(12, 6)
  discountType    DiscountType?
  discountValue   Decimal        @default(0) @db.Decimal(12, 2)
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  /// Copied from the sales order. Controls whether the PDF itemises bundles.
  showSubItemsOnInvoice Boolean  @default(false)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?

  items          InvoiceItem[]
  payments       Payment[]
  schedules      PaymentSchedule[]
  refunds        Refund[]
  units          ProductUnit[]
  warrantyClaims WarrantyClaim[]

  @@index([status])
  @@index([type, issueDate])
  @@index([clientId])
  @@index([supplierId])
}

model InvoiceItem {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2) // price snapshot at time of transaction
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)

  isComposite   Boolean       @default(false)
  parentItemId  String?
  parentItem    InvoiceItem?  @relation("InvoiceItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems      InvoiceItem[] @relation("InvoiceItemTree")

  @@index([parentItemId])
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  CASH
  WHISH
  OMT
  STORE_CREDIT
}

model Payment {
  id           String           @id @default(uuid())
  number       String           @unique
  direction    PaymentDirection
  invoiceId    String?
  invoice      Invoice?         @relation(fields: [invoiceId], references: [id])
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id])
  supplierId   String?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  scheduleId   String?
  schedule     PaymentSchedule? @relation(fields: [scheduleId], references: [id])
  method       PaymentMethod
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("USD")
  exchangeRate Decimal          @default(1) @db.Decimal(12, 6)
  paymentDate  DateTime         @default(now())
  reference    String?
  notes        String?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  @@index([paymentDate])
  @@index([direction])
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentSchedule {
  id            String         @id @default(uuid())
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Decimal        @db.Decimal(12, 2)
  status        ScheduleStatus @default(PENDING)
  paidAt        DateTime?

  payments Payment[]

  @@unique([invoiceId, installmentNo])
  @@index([status, dueDate])
}

// ============ Refunds & Returns ============

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundReason {
  DEFECTIVE
  WRONG_ITEM
  CHANGE_OF_MIND
  OTHER
}

enum RefundMethod {
  CASH
  STORE_CREDIT
  EXCHANGE
}

model Refund {
  id           String       @id @default(uuid())
  number       String       @unique
  invoiceId    String
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  status       RefundStatus @default(PENDING)
  reason       RefundReason @default(OTHER)
  method       RefundMethod @default(CASH)
  totalAmount  Decimal      @default(0) @db.Decimal(12, 2)
  notes        String?
  createdById  String
  createdBy    User         @relation("RefundCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?        @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  items ReturnItem[]

  @@index([status])
}

enum ItemCondition {
  RESELLABLE
  DAMAGED
}

model ReturnItem {
  id            String        @id @default(uuid())
  refundId      String
  refund        Refund        @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  condition     ItemCondition @default(RESELLABLE)
  serialNumbers Json?
}

enum SupplierReturnStatus {
  PENDING
  SENT
  CREDITED
  REPLACED
  CLOSED
}

model SupplierReturn {
  id            String               @id @default(uuid())
  number        String               @unique
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  status        SupplierReturnStatus @default(PENDING)
  creditNoteRef String?
  notes         String?
  items         Json // [{ productId, quantity, serialNumbers, reason }]
  createdAt     DateTime             @default(now())
  deletedAt     DateTime?
}

// ============ Warranty & Service ============

enum ClaimStatus {
  OPEN
  SENT_TO_SUPPLIER
  RESOLVED
  REPLACED
  REJECTED
}

model WarrantyClaim {
  id            String       @id @default(uuid())
  number        String       @unique
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  serialNumber  String?
  issue         String
  status        ClaimStatus  @default(OPEN)
  resolution    String?
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  deletedAt     DateTime?

  @@index([status])
}

enum ServiceJobType {
  INSTALLATION
  MAINTENANCE
  SURVEY
  REPAIR
}

enum ServiceJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceJob {
  id             String           @id @default(uuid())
  number         String           @unique
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  salesOrderId   String?
  salesOrder     SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  type           ServiceJobType   @default(INSTALLATION)
  status         ServiceJobStatus @default(SCHEDULED)
  technicianName String?
  scheduledDate  DateTime?
  completedDate  DateTime?
  notes          String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?

  @@index([status, scheduledDate])
}

// ============ Solar Operations ============

enum SystemType {
  ON_GRID
  OFF_GRID
  HYBRID
}

enum InstallationStatus {
  SURVEY
  DESIGN
  APPROVED
  INSTALLING
  COMMISSIONED
  ACTIVE
  ON_HOLD
  CANCELLED
}

model Installation {
  id                 String             @id @default(uuid())
  number             String             @unique
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id])
  salesOrderId       String?
  salesOrder         SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  status             InstallationStatus @default(SURVEY)
  systemType         SystemType         @default(HYBRID)
  siteAddress        String?
  city               String?
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  capacityKw         Decimal            @default(0) @db.Decimal(8, 2)
  panelCount         Int                @default(0)
  batteryKwh         Decimal            @default(0) @db.Decimal(8, 2)
  tariffPerKwh       Decimal            @default(0.20) @db.Decimal(6, 3) // grid price used for savings estimates
  expectedMonthlyKwh Decimal?           @db.Decimal(10, 2)
  installedAt        DateTime?
  commissionedAt     DateTime?
  notes              String?
  createdById        String
  createdBy          User               @relation(fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  deletedAt          DateTime?

  readings  EnergyReading[]
  contracts MaintenanceContract[]

  @@index([status])
  @@index([clientId])
}

model EnergyReading {
  id             String       @id @default(uuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  readingDate    DateTime     @db.Date
  energyKwh      Decimal      @db.Decimal(10, 2)
  peakPowerKw    Decimal?     @db.Decimal(8, 2)
  sunHours       Decimal?     @db.Decimal(4, 1)
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([installationId, readingDate])
  @@index([readingDate])
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model MaintenanceContract {
  id             String         @id @default(uuid())
  number         String         @unique
  installationId String
  installation   Installation   @relation(fields: [installationId], references: [id])
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime
  visitsPerYear  Int            @default(2)
  pricePerYear   Decimal        @default(0) @db.Decimal(12, 2)
  lastVisitDate  DateTime?
  nextVisitDate  DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  @@index([status, nextVisitDate])
}

// ============ Expenses ============

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  TRANSPORT
  MARKETING
  EQUIPMENT
  MAINTENANCE
  OTHER
}

model Expense {
  id            String          @id @default(uuid())
  number        String          @unique
  category      ExpenseCategory @default(OTHER)
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  expenseDate   DateTime        @default(now())
  vendor        String?
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?

  @@index([category, expenseDate])
  @@index([expenseDate])
}

// ============ Notifications & Settings ============

enum NotificationType {
  LOW_STOCK
  PAYMENT_DUE
  PAYMENT_OVERDUE
  WARRANTY_EXPIRING
  QUOTATION_EXPIRING
  WARRANTY_CLAIM_OPENED
  SHELF_LIFE_ALERT
  MAINTENANCE_VISIT_DUE
  CONTRACT_EXPIRING
  READING_GAP
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  entity    String?
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
}

model Setting {
  key   String @id
  value Json
}

model NumberSequence {
  id         String @id @default(uuid())
  entity     String @unique // INVOICE, QUOTATION, SALES_ORDER, PURCHASE_ORDER, PAYMENT, REFUND, CLAIM, JOB, SUPPLIER_RETURN
  prefix     String
  nextNumber Int    @default(1)
  padding    Int    @default(5)
}

enum BackupStatus {
  SUCCESS
  FAILED
}

// History of backup/restore runs. Kept separate from the backup file itself
// (which is overwritten in place) so operators have an audit trail even
// though only the latest snapshot is stored on disk. Excluded from the
// backup/restore payload itself so its own history survives a restore.
model BackupLog {
  id          String       @id @default(uuid())
  type        String // BACKUP | RESTORE
  status      BackupStatus
  filename    String?
  sizeBytes   Int?
  tableCount  Int?
  rowCount    Int?
  error       String?
  triggeredBy String? // user id, or "SCHEDULER"
  durationMs  Int?
  createdAt   DateTime     @default(now())

  @@index([createdAt])
}

// ============ Workers, Attendance & Payroll ============

enum PayPeriod {
  WEEKLY
  MONTHLY
}

/// How a worker is paid. A daily worker earns `dailyRate` per attended day; an
/// hourly worker earns `hourlyRate` per hour of `expectedHoursPerDay`.
enum PayBasis {
  DAILY
  HOURLY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  /// Excused: counted as not worked, but never deducted (approved leave).
  LEAVE
  HOLIDAY
}

model Worker {
  id                String            @id @default(uuid())
  code              String            @unique
  name              String
  phone             String?
  email             String?
  jobTitle          String?
  payBasis          PayBasis          @default(DAILY)
  /// Earned per full attended day when payBasis is DAILY.
  dailyRate         Decimal           @default(0) @db.Decimal(12, 2)
  /// Earned per hour when payBasis is HOURLY.
  hourlyRate        Decimal           @default(0) @db.Decimal(12, 2)
  expectedHoursPerDay Decimal         @default(8) @db.Decimal(5, 2)
  /// Deducted per hour of lateness. Zero means lateness is recorded but unpaid-for.
  lateDeductionPerHour Decimal        @default(0) @db.Decimal(12, 2)
  payPeriod         PayPeriod         @default(MONTHLY)
  hiredOn           DateTime?
  isActive          Boolean           @default(true)
  notes             String?
  createdAt         DateTime          @default(now())
  deletedAt         DateTime?

  attendance        AttendanceEntry[]

  @@index([name])
}

/// One worker, one calendar day. The unique pair makes a day idempotent to
/// record — logging the same date twice corrects it rather than duplicating it.
model AttendanceEntry {
  id          String           @id @default(uuid())
  workerId    String
  worker      Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  /// Hours actually worked. Defaults to the worker's expected hours on save.
  hoursWorked Decimal          @default(0) @db.Decimal(5, 2)
  /// Hours late. Priced at the worker's lateDeductionPerHour.
  lateHours   Decimal          @default(0) @db.Decimal(5, 2)
  /// One-off addition (bonus) or subtraction (advance) for this day.
  bonus       Decimal          @default(0) @db.Decimal(12, 2)
  deduction   Decimal          @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([workerId, date])
  @@index([date])
}
