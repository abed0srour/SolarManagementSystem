  serialNumbers Json?

  @@index([tenantId])
}

enum SupplierReturnStatus {
  PENDING
  SENT
  CREDITED
  REPLACED
  CLOSED
}

/// How the supplier gives the money back. CASH/WHISH/OMT record an INCOMING
/// Payment (cash actually returns to us); CREDIT_NOTE only reduces what we owe
/// on the purchase order, so no Payment row is written.
enum SupplierRefundMethod {
  CASH
  WHISH
  OMT
  CREDIT_NOTE
}

model SupplierReturn {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId        String               @default("")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number          String
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  /// Set when the return came from a specific purchase order. Standalone
  /// returns (recorded straight against a supplier) leave it null.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  /// Warehouse the goods physically left.
  warehouseId     String?
  warehouse       Warehouse?           @relation(fields: [warehouseId], references: [id])
  status          SupplierReturnStatus @default(PENDING)
  refundMethod    SupplierRefundMethod @default(CASH)
  totalAmount     Decimal              @default(0) @db.Decimal(12, 2)
  creditNoteRef   String?
  notes           String?
  items           Json // [{ productId, quantity, unitCost, serialNumbers, reason }]
  createdById     String?
  createdBy       User?                @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  deletedAt       DateTime?

  @@unique([tenantId, number])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([tenantId])
}

