  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2) // price snapshot at time of transaction
  discountType  DiscountType?
