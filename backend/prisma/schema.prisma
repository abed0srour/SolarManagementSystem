  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
  @@index([tenantId])
}

model Setting {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId String @default("")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  value    Json

  @@unique([tenantId, key])
  @@index([tenantId])
}

model NumberSequence {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId   String @default("")
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity     String // INVOICE, QUOTATION, SALES_ORDER, PURCHASE_ORDER, PAYMENT, REFUND, CLAIM, JOB, SUPPLIER_RETURN
  prefix     String
  nextNumber Int    @default(1)
  padding    Int    @default(5)

  @@unique([tenantId, entity])
  @@index([tenantId])
}

enum BackupStatus {
  SUCCESS
  FAILED
}

// History of backup/restore runs. Kept separate from the backup file itself
// (which is overwritten in place) so operators have an audit trail even
// though only the latest snapshot is stored on disk. Excluded from the
// backup/restore payload itself so its own history survives a restore.
model BackupLog {
  id String @id @default(uuid())

  /// Owning tenant. Null on platform-level rows that belong to no store (the super admin).
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  type        String // BACKUP | RESTORE
  status      BackupStatus
  filename    String?
  sizeBytes   Int?
  tableCount  Int?
  rowCount    Int?
  error       String?
  triggeredBy String? // user id, or "SCHEDULER"
  durationMs  Int?
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([tenantId])
}

// ============ Workers, Attendance & Payroll ============

enum PayPeriod {
  WEEKLY
  MONTHLY
}

/// How a worker is paid. A daily worker earns `dailyRate` per attended day; an
/// hourly worker earns `hourlyRate` per hour of `expectedHoursPerDay`.
enum PayBasis {
  DAILY
  HOURLY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  /// Excused: counted as not worked, but never deducted (approved leave).
  LEAVE
  HOLIDAY
}

model Worker {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId             String    @default("")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  phone                String?
  email                String?
  jobTitle             String?
  payBasis             PayBasis  @default(DAILY)
  /// Earned per full attended day when payBasis is DAILY.
  dailyRate            Decimal   @default(0) @db.Decimal(12, 2)
  /// Earned per hour when payBasis is HOURLY.
  hourlyRate           Decimal   @default(0) @db.Decimal(12, 2)
  expectedHoursPerDay  Decimal   @default(8) @db.Decimal(5, 2)
  /// Deducted per hour of lateness. Zero means lateness is recorded but unpaid-for.
  lateDeductionPerHour Decimal   @default(0) @db.Decimal(12, 2)
  payPeriod            PayPeriod @default(MONTHLY)
  hiredOn              DateTime?
  isActive             Boolean   @default(true)
  notes                String?
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  attendance AttendanceEntry[]

  @@unique([tenantId, code])
  @@index([name])
  @@index([tenantId])
}

/// One worker, one calendar day. The unique pair makes a day idempotent to
/// record — logging the same date twice corrects it rather than duplicating it.
model AttendanceEntry {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId    String           @default("")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  /// Hours actually worked. Defaults to the worker's expected hours on save.
  hoursWorked Decimal          @default(0) @db.Decimal(5, 2)
  /// Hours late. Priced at the worker's lateDeductionPerHour.
  lateHours   Decimal          @default(0) @db.Decimal(5, 2)
  /// One-off addition (bonus) or subtraction (advance) for this day.
  bonus       Decimal          @default(0) @db.Decimal(12, 2)
  deduction   Decimal          @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([workerId, date])
  @@index([date])
  @@index([tenantId])
}

/// One recorded change in a serialized unit's life.
///
/// The unit row itself only ever holds the unit's *current* state, so the
/// moment it moves from IN_STOCK to DAMAGED the reason, the date and the person
/// are gone. That is exactly what is needed to answer "this inverter failed —
/// who supplied it, when did we take it in, and what has happened to it since".
/// The supplier is not copied here: it is reachable through the unit's purchase
/// order, and duplicating it would let the two disagree.
model ProductUnitEvent {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId String @default("")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  unitId String
  unit   ProductUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  /// Null on the first event, where the unit had no prior state.
  fromStatus UnitStatus?
  toStatus   UnitStatus
  note       String?

  /// What caused the change — "PurchaseOrder", "SalesOrder", "Refund" — and its
  /// id, so the event can be traced back to the document that drove it.
  refType String?
  refId   String?

  /// Null when a scheduler or an import made the change rather than a person.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([unitId, createdAt])
  @@index([tenantId])
}
