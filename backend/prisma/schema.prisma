enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundReason {
  DEFECTIVE
  WRONG_ITEM
  CHANGE_OF_MIND
  OTHER
}

enum RefundMethod {
  CASH
  STORE_CREDIT
  EXCHANGE
}

model Refund {
