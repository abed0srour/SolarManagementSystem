generator client {
  provider        = "prisma-client-js"
  // relationJoins: load included relations via a single SQL JOIN instead of
  // one query per relation — critical over a high-latency remote database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ Tenancy ============

enum TenantStatus {
  /// Fully operational.
  ACTIVE
  /// Blocked at login. Data is untouched; reactivating restores access exactly.
  SUSPENDED
  /// Retired by the super admin. Behaves like SUSPENDED and is hidden by default.
  ARCHIVED
}

/// A store / organization. This is the hard boundary of the system: no query
/// issued on behalf of a tenant user can read or write a row owned by another
/// tenant. Enforcement is central rather than per-query — see
/// `src/prisma/tenant-scope.ts`, which rewrites every Prisma operation before
/// it reaches the database.
///
/// Note on `tenantId String @default("")` throughout this schema: the empty
/// default is a TypeScript affordance, not a real value. Without it the
/// generated types would demand `tenantId` on every one of the ~100 `create()`
/// calls in this codebase, which is exactly the per-call-site discipline the
/// scoping extension exists to remove — and one forgotten call site is a
/// cross-tenant bug. The default is never written: the extension stamps the
/// real tenant on every create, and if anything ever slipped past it, `""`
/// matches no Tenant and the foreign key rejects the row. Fail-closed either
/// way.
model Tenant {
  id           String       @id @default(uuid())
  /// Store name, shown throughout that tenant's own UI.
  name         String
  /// URL-safe handle, unique across the platform.
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  contactEmail String?
  contactPhone String?
  notes        String?

  /// Access limits, enforced when the tenant creates records. Null = unlimited.
  maxUsers    Int?
  maxProducts Int?
  maxClients  Int?
  /// Hard cut-off for access, e.g. the end of a paid period. Null never expires.
  expiresAt   DateTime?

  suspendedAt     DateTime?
  suspendedReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories           Category[]
  subCategories        SubCategory[]
  attributeDefinitions AttributeDefinition[]
  productAttributes    ProductAttribute[]
  products             Product[]
  priceHistory         PriceHistory[]
  compatibilityLinks   CompatibilityLink[]
  warehouses           Warehouse[]
  stockLevels          StockLevel[]
  productUnits         ProductUnit[]
  productUnitEvents    ProductUnitEvent[]
  stockMovements       StockMovement[]
  clients              Client[]
  clientAddresses      ClientAddress[]
  suppliers            Supplier[]
  supplierProducts     SupplierProduct[]
  quotations           Quotation[]
  quotationItems       QuotationItem[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  payments             Payment[]
  paymentSchedules     PaymentSchedule[]
  refunds              Refund[]
  returnItems          ReturnItem[]
  supplierReturns      SupplierReturn[]
  warrantyClaims       WarrantyClaim[]
  serviceJobs          ServiceJob[]
  installations        Installation[]
  energyReadings       EnergyReading[]
  maintenanceContracts MaintenanceContract[]
  expenses             Expense[]
  notifications        Notification[]
  settings             Setting[]
  numberSequences      NumberSequence[]
  workers              Worker[]
  attendanceEntries    AttendanceEntry[]
  attachments          Attachment[]
  users                User[]
  auditLogs            AuditLog[]
  loginHistory         LoginHistory[]
  backupLogs           BackupLog[]
  profiles             Profile[]

  @@index([status])
}

/// The Supabase Auth projection of an account: which store it belongs to and
/// what it may do there. Created by the `on_auth_user_created` trigger and read
/// by the Custom Access Token Hook, which signs `role` and `tenant_id` into
/// every access token.
///
/// Defined in SQL rather than by Prisma, because it holds a foreign key into
/// `auth.users` — a schema Prisma does not manage. This model exists so the API
/// can read and write it with the same client as everything else; the source of
/// truth for its shape is
/// `supabase/migrations/20260822091000_profiles_and_signup_trigger.sql`.
model Profile {
  id String @id @db.Uuid

  /// Owning tenant. Null on platform-level rows that belong to no store (the super admin).
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email       String
  /// Coarse tier: super_admin | tenant_admin | staff.
  role        String   @default("staff")
  /// Fine-grained application role: ADMIN | MANAGER | STAFF | VIEWER.
  appRole     String   @default("STAFF") @map("app_role")
  permissions String[] @default([])
  fullName    String?  @map("full_name")
  phone       String?
  avatarUrl   String?  @map("avatar_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("profiles")
}

// ============ Users, Auth & Audit ============

/// Two tiers live in one enum, separated by `User.tenantId`:
///
///   - SUPER_ADMIN is a *platform* role. It always has `tenantId = null`, owns no
///     store data of its own, and is the only role that can create or suspend
///     tenants. It is deliberately barred from tenant business endpoints — see
///     `PermissionsGuard` — so "manages every store" never quietly becomes
///     "reads every store's ledger".
///   - Everything below it is a *tenant* role and always carries a `tenantId`.
///     ADMIN is the Tenant Admin: full access inside its own store, including
///     managing that store's own staff accounts.
enum Role {
  /// Platform owner. Not a member of any tenant.
  SUPER_ADMIN
  /// Tenant Admin: owns one store and everything in it.
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

model User {
  id String @id @default(uuid())

  /// Owning tenant. Null on platform-level rows that belong to no store (the super admin).
  tenantId            String?
  tenant              Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email               String    @unique
  /// Legacy: credentials moved to `auth.users` when Supabase Auth took over.
  /// Kept (and nullable) so no historic row was rewritten by that migration.
  passwordHash        String?
  name                String
  role                Role      @default(STAFF)
  /// Per-account override of the role's default permissions. Empty means "use
  /// the role's defaults" — not "no access" — so existing accounts are
  /// unaffected by the introduction of permissions.
  permissions         String[]  @default([])
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  verificationCodes  VerificationCode[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  priceChanges       PriceHistory[]
  stockMovements     StockMovement[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  salesOrdersClaimed SalesOrder[]         @relation("SalesOrderClaimedBy")
  purchaseOrders     PurchaseOrder[]
  invoices           Invoice[]
  payments           Payment[]
  refundsCreated     Refund[]             @relation("RefundCreatedBy")
  refundsApproved    Refund[]             @relation("RefundApprovedBy")
  warrantyClaims     WarrantyClaim[]
  serviceJobs        ServiceJob[]
  goodsReceipts      GoodsReceipt[]
  attachments        Attachment[]
  installations      Installation[]
  expenses           Expense[]
  supplierReturns    SupplierReturn[]
  productUnitEvents  ProductUnitEvent[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Short-lived numeric codes emailed to confirm sensitive account changes
model VerificationCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // EMAIL_CHANGE | PASSWORD_CHANGE
  newEmail  String?
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model LoginHistory {
  id String @id @default(uuid())

  /// Owning tenant. Null on platform-level rows that belong to no store (the super admin).
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([tenantId])
}

model AuditLog {
  id String @id @default(uuid())

  /// Owning tenant. Null on platform-level rows that belong to no store (the super admin).
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([tenantId])
}

model Attachment {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity       String // e.g. "Product", "Client", "WarrantyClaim", "ServiceJob", "Supplier", "Company"
  entityId     String
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
  @@index([tenantId])
}

// ============ Catalog ============

model Category {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  subCategories SubCategory[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SubCategory {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String                @default("")
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  deletedAt     DateTime?
  attributeDefs AttributeDefinition[]
  products      Product[]

  @@unique([categoryId, name])
  @@index([tenantId])
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model AttributeDefinition {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subCategoryId String
  subCategory   SubCategory   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  name          String // machine key, e.g. "wattage"
  label         String // display label, e.g. "Wattage"
  type          AttributeType @default(TEXT)
  unit          String? // e.g. "W", "kWh", "V"
  options       Json? // for SELECT type: ["On-grid","Off-grid","Hybrid"]
  required      Boolean       @default(false)
  sortOrder     Int           @default(0)

  @@unique([subCategoryId, name])
  @@index([tenantId])
}

enum DynamicAttributeType {
  STRING
  INTEGER
  DECIMAL
  FLOAT
  BOOLEAN
}

model ProductAttribute {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId        String               @default("")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String // e.g. "Color", "Size", "Dimensions", "Capacity"
  type            DynamicAttributeType @default(STRING) // STRING, INTEGER, DECIMAL, FLOAT, BOOLEAN
  unit            String? // e.g. "mm", "kW", "V", "Ah"
  isFreeForm      Boolean              @default(false)
  permittedValues Json? // array of permitted values, e.g. ["Red", "Blue"] or [10, 20] or [true, false]
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([productId, name])
  @@index([tenantId])
  @@index([productId])
}

model Product {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId                  String      @default("")
  tenant                    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                       String
  name                      String
  brand                     String?
  model                     String?
  subCategoryId             String
  subCategory               SubCategory @relation(fields: [subCategoryId], references: [id])
  attributes                Json        @default("{}") // flexible technical specs per sub-category
  costPrice                 Decimal     @db.Decimal(12, 2)
  salePrice                 Decimal     @db.Decimal(12, 2)
  priceUpdatedAt            DateTime    @default(now())
  // Services (installation, delivery…) are sellable but carry no stock
  isService                 Boolean     @default(false)
  /// Capture a serial per unit when goods are received.
  trackSerials              Boolean     @default(true)
  /// Ask which specific units are leaving when an order is confirmed.
  requireSerialOnSale       Boolean     @default(true)
  lowStockThreshold         Int         @default(5)
  warrantyMonths            Int? // product warranty
  performanceWarrantyMonths Int? // panels: output/performance warranty
  shelfLifeMonths           Int? // lead-acid batteries
  barcode                   String?
  imageUrl                  String?
  notes                     String?
  isActive                  Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  deletedAt                 DateTime?

  // Variant & Parent-Child support
  parentProductId   String?
  parent            Product?           @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: Cascade)
  variants          Product[]          @relation("ProductVariants")
  isVariant         Boolean            @default(false)
  hasVariants       Boolean            @default(false)
  variantAttributes Json               @default("{}")
  customAttributes  ProductAttribute[]

  priceHistory       PriceHistory[]
  stockLevels        StockLevel[]
  units              ProductUnit[]
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  returnItems        ReturnItem[]
  warrantyClaims     WarrantyClaim[]
  compatibleFrom     CompatibilityLink[] @relation("CompatFrom")
  compatibleTo       CompatibilityLink[] @relation("CompatTo")

  @@unique([tenantId, sku])
  @@index([name])
  @@index([brand])
  @@index([subCategoryId])
  @@index([tenantId])
  @@index([parentProductId])
}

model PriceHistory {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldCostPrice Decimal? @db.Decimal(12, 2)
  newCostPrice Decimal? @db.Decimal(12, 2)
  oldSalePrice Decimal? @db.Decimal(12, 2)
  newSalePrice Decimal? @db.Decimal(12, 2)
  reason       String?
  changedById  String?
  changedBy    User?    @relation(fields: [changedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@index([tenantId])
}

model CompatibilityLink {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId         String  @default("")
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation("CompatFrom", fields: [productId], references: [id], onDelete: Cascade)
  compatibleWithId String
  compatibleWith   Product @relation("CompatTo", fields: [compatibleWithId], references: [id], onDelete: Cascade)
  note             String?

  @@unique([productId, compatibleWithId])
  @@index([tenantId])
}

// ============ Inventory ============

model Warehouse {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId  String    @default("")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  stockLevels     StockLevel[]
  units           ProductUnit[]
  movementsFrom   StockMovement[]  @relation("MoveFrom")
  movementsTo     StockMovement[]  @relation("MoveTo")
  salesOrders     SalesOrder[]
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model StockLevel {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId    String    @default("")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  reserved    Int       @default(0)

  @@unique([productId, warehouseId])
  @@index([tenantId])
}

enum UnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  RETURNED_TO_SUPPLIER
}

model ProductUnit {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId                   String         @default("")
  tenant                     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId                  String
  product                    Product        @relation(fields: [productId], references: [id])
  serialNumber               String
  status                     UnitStatus     @default(IN_STOCK)
  warehouseId                String?
  warehouse                  Warehouse?     @relation(fields: [warehouseId], references: [id])
  manufactureDate            DateTime?
  purchaseOrderId            String?
  purchaseOrder              PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId               String?
  salesOrder                 SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  invoiceId                  String?
  invoice                    Invoice?       @relation(fields: [invoiceId], references: [id])
  warrantyStartDate          DateTime?
  warrantyEndDate            DateTime?
  performanceWarrantyEndDate DateTime?
  createdAt                  DateTime       @default(now())

  warrantyClaims WarrantyClaim[]
  events         ProductUnitEvent[]

  @@unique([tenantId, serialNumber])
  @@index([productId, status])
  @@index([warrantyEndDate])
  @@index([tenantId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

model StockMovement {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String       @default("")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation("MoveFrom", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?   @relation("MoveTo", fields: [toWarehouseId], references: [id])
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  reason        String?
  refType       String? // e.g. "SalesOrder", "PurchaseOrder", "Refund"
  refId         String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([tenantId])
}

// ============ Parties ============

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum ClientTier {
  RETAIL
  WHOLESALE
  INSTALLER
}

model Client {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId    String     @default("")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        ClientType @default(INDIVIDUAL)
  tier        ClientTier @default(RETAIL)
  email       String?
  phone       String?
  taxNumber   String?
  creditLimit Decimal    @default(0) @db.Decimal(12, 2)
  storeCredit Decimal    @default(0) @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  addresses      ClientAddress[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  warrantyClaims WarrantyClaim[]
  serviceJobs    ServiceJob[]
  installations  Installation[]

  @@index([name])
  @@index([tenantId])
}

model ClientAddress {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId       String  @default("")
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label          String  @default("Main")
  line1          String
  city           String?
  isBilling      Boolean @default(true)
  isInstallation Boolean @default(false)

  @@index([tenantId])
}

model Supplier {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId     String    @default("")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  leadTimeDays Int?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  products        SupplierProduct[]
  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[]
  payments        Payment[]
  supplierReturns SupplierReturn[]

  @@index([name])
  @@index([tenantId])
}

model SupplierProduct {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierPrice Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([tenantId])
}

// ============ Sales Cycle ============

enum DiscountType {
  PERCENT
  FIXED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String          @default("")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?
  discountType  DiscountType?
  discountValue Decimal         @default(0) @db.Decimal(12, 2)
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([tenantId, number])
  @@index([status])
  @@index([tenantId])
}

model QuotationItem {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationId   String
  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String?
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)

  isComposite  Boolean         @default(false)
  autoPrice    Boolean         @default(true)
  parentItemId String?
  parentItem   QuotationItem?  @relation("QuotationItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems     QuotationItem[] @relation("QuotationItemTree")

  @@index([parentItemId])
  @@index([tenantId])
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId              String           @default("")
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number                String
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id])
  quotationId           String?
  quotation             Quotation?       @relation(fields: [quotationId], references: [id])
  warehouseId           String
  warehouse             Warehouse        @relation(fields: [warehouseId], references: [id])
  status                SalesOrderStatus @default(PENDING)
  orderDate             DateTime         @default(now())
  discountType          DiscountType?
  discountValue         Decimal          @default(0) @db.Decimal(12, 2)
  subtotal              Decimal          @default(0) @db.Decimal(12, 2)
  shippingFee           Decimal          @default(0) @db.Decimal(12, 2)
  total                 Decimal          @default(0) @db.Decimal(12, 2)
  notes                 String?
  /// Print bundle contents on the customer's invoice. Off by default: the
  /// customer sees one package line, the warehouse still sees every component.
  showSubItemsOnInvoice Boolean          @default(false)

  /// Short code printed on the POS receipt. The customer brings it to the
  /// warehouse, where it is the only thing needed to find and release the goods.
  pickupCode  String?
  /// Set the moment the warehouse hands the goods over. Also the guard that
  /// stops one receipt being claimed twice.
  claimedAt   DateTime?
  claimedById String?
  claimedBy   User?     @relation("SalesOrderClaimedBy", fields: [claimedById], references: [id])
  claimNotes  String?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  items         SalesOrderItem[]
  invoices      Invoice[]
  serviceJobs   ServiceJob[]
  units         ProductUnit[]
  installations Installation[]

  @@unique([tenantId, number])
  @@unique([tenantId, pickupCode])
  @@index([status])
  @@index([clientId])
  @@index([tenantId])
}

model SalesOrderItem {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrderId  String
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  // Null on composite bundle headers and on descriptive sub-items, which are
  // typed by hand rather than picked from the catalogue.
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  description   String?
  // Decimal so metered sub-items can carry 12.5 m of cable. Catalogue lines
  // still hold whole numbers — they are the only ones that move stock.
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  /// Unit of measure for sub-items: pcs, set, m, ft…
  unit          String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal       @db.Decimal(12, 2)
  deliveredQty  Int           @default(0)

  /// True on a bundle header. Its own price is the sum of its sub-items unless overridden.
  isComposite  Boolean          @default(false)
  /// When true the bundle price is recomputed from its sub-items on every save.
  autoPrice    Boolean          @default(true)
  parentItemId String?
  parentItem   SalesOrderItem?  @relation("SalesOrderItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems     SalesOrderItem[] @relation("SalesOrderItemTree")

  @@index([parentItemId])
  @@index([tenantId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId         String              @default("")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number           String
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId      String
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  currency         String              @default("USD")
  exchangeRate     Decimal             @default(1) @db.Decimal(12, 6)
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  hasDeliveryCost  Boolean             @default(false)
  deliveryCost     Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal             @default(0) @db.Decimal(12, 2)
  /// Value of goods sent back to the supplier. The PO's effective bill is
  /// `total - returnedAmount`, which is what paidAmount is measured against.
  returnedAmount   Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  units         ProductUnit[]
  payments      Payment[]
  returns       SupplierReturn[]

  @@unique([tenantId, number])
  @@index([status])
  @@index([supplierId])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId        String        @default("")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
  returnedQty     Int           @default(0)
  lineTotal       Decimal       @db.Decimal(12, 2)

  @@index([tenantId])
}

model GoodsReceipt {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId        String        @default("")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?
  discrepancies   String?
  items           Json // [{ productId, quantity, serialNumbers: [] }]
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@index([tenantId])
}

// ============ Invoicing & Payments ============

enum InvoiceType {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId              String         @default("")
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number                String
  type                  InvoiceType    @default(SALE)
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id])
  supplierId            String?
  supplier              Supplier?      @relation(fields: [supplierId], references: [id])
  salesOrderId          String?
  salesOrder            SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  status                InvoiceStatus  @default(UNPAID)
  issueDate             DateTime       @default(now())
  dueDate               DateTime?
  currency              String         @default("USD")
  exchangeRate          Decimal        @default(1) @db.Decimal(12, 6)
  discountType          DiscountType?
  discountValue         Decimal        @default(0) @db.Decimal(12, 2)
  subtotal              Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee           Decimal        @default(0) @db.Decimal(12, 2)
  total                 Decimal        @default(0) @db.Decimal(12, 2)
