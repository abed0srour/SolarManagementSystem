  @@index([status])
  @@index([type, issueDate])
  @@index([clientId])
  @@index([supplierId])
  @@index([tenantId])
}

model InvoiceItem {
  id String @id @default(uuid())

  /// Owning tenant. Every read and write is scoped to it.
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String
