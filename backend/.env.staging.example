# ==============================================================================
# Solar Store Backend - Staging Environment Template (.env.staging)
# ==============================================================================
# Set these variables in your Staging Hosting environment (Vercel Preview / Railway)
# and in GitHub Actions Secrets for Staging pipelines.
#
# IMPORTANT: Staging MUST use a dedicated, isolated Supabase Staging project!

NODE_ENV="staging"
PORT=3000

# --- Database Connections (Staging Supabase Project) ---
# Pooled connection via PgBouncer (port 6543) - used by serverless runtime
DATABASE_URL="postgresql://postgres.<staging_ref>:<staging_db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) - required for Prisma & Supabase schema migrations
DIRECT_URL="postgresql://postgres.<staging_ref>:<staging_db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Staging Project) ---
SUPABASE_URL="https://<staging_ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<staging_supabase_service_role_key>"
# Omit SUPABASE_JWT_SECRET if Staging Supabase project uses standard asymmetric JWKS verification:
# SUPABASE_JWT_SECRET="<staging_legacy_jwt_secret_if_applicable>"

# --- Application Routing & Security ---
# URL of the Staging Next.js Frontend
APP_URL="https://staging.solarstore.example.com"

# Generate unique staging secrets using `openssl rand -base64 48` / `openssl rand -hex 32`
JWT_SECRET="<staging_random_jwt_secret_min_48_chars>"
CRON_SECRET="<staging_random_cron_secret_hex_32>"

# Whitelist Staging Frontend URL
CORS_ORIGINS="https://staging.solarstore.example.com"

# --- Staging File Storage ---
# Connected Vercel Blob store for staging uploads and backups
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<staging_blob_token>"

# --- Email Notifications (Staging Sandbox / Mailtrap / Sendgrid) ---
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER="<staging_smtp_user>"
SMTP_PASS="<staging_smtp_pass>"
MAIL_FROM="Solar Store Staging <staging@solarstore.example.com>"

# --- Dummy Data Seeding (Staging Only) ---
SEED_TENANT_SLUG="default"
SEED_ADMIN_EMAIL="admin@staging-solarstore.example.com"
