# ==============================================================================
# Solar Store Backend - Local Development Environment (.env / .env.local)
# ==============================================================================
# Copy this file to .env (or .env.local) for local development. Never commit .env.

NODE_ENV="development"
PORT=3000

# --- Database Connections (Local Postgres / Docker) ---
# When running with `docker compose up -d`:
DATABASE_URL="postgresql://postgres:admin@localhost:5432/solar_store?schema=public"
DIRECT_URL="postgresql://postgres:admin@localhost:5432/solar_store?schema=public"

# When using local Supabase CLI (`supabase start`):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Auth (Local Stack) ---
# Default credentials output from `supabase start`:
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIMUtXDnVOX8w1CHISkPWkJnumwP5cgHgFd_D_BgKA"

# --- Application Routing & Security ---
# Where frontend invite and password-reset links should land
APP_URL="http://localhost:5173"

# Signs pickup QR codes printed on receipts.
JWT_SECRET="dev-insecure-jwt-secret-replace-with-openssl-rand-in-hosted-envs"

# Authorizes cron trigger endpoints (/api/cron/*)
CRON_SECRET="dev-cron-secret-local-testing"

# CORS origins (leave unset locally to reflect any origin, or specify localhost)
# CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- File Storage ---
# Leave unset in local development to store uploads on local disk (backend/uploads/).
# In cloud environments, this is provided by Vercel Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Email Notifications (Optional for Local) ---
# If unset, email sending is skipped without error.
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Solar Store Local <no-reply@solarstore.local>"

# --- Database Seeding ---
SEED_TENANT_SLUG="default"
SEED_ADMIN_EMAIL="admin@solarstore.local"
SEED_ADMIN_PASSWORD="TenantAdmin!2026"
