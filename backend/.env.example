# Copy to .env and fill in. Never commit .env itself.

# --- Database (Supabase) ---
# DATABASE_URL is the POOLED connection (PgBouncer, port 6543). Serverless
# functions open a connection per invocation, so they must go through the pooler
# or Postgres runs out of connections under any real traffic.
#
# DIRECT_URL is the direct connection (port 5432). Prisma uses it for migrations,
# which PgBouncer's transaction pooling cannot run.
#
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local development with the repo's docker-compose.yml instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solar?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/solar?schema=public"

# --- Auth (Supabase) ---
# Identity lives in Supabase Auth. This API does not issue tokens; it verifies
# the ones Supabase signs, and reads `role` and `tenant_id` from their claims.
#
# Local stack: `supabase start` prints all three of these.
SUPABASE_URL="http://127.0.0.1:54321"
# Verifies incoming access tokens. Projects using asymmetric signing keys can
# leave this unset — verification falls back to the project's JWKS endpoint.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
# Creates, suspends and deletes accounts. Full admin over every user, bypasses
# RLS entirely — server only, never sent to a browser, never in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="change-me"

# Where invite and password-reset links should land.
APP_URL="http://localhost:5173"

# Signs the pickup QR codes printed on receipts. Changing it invalidates every
# QR already printed. Use a long random value: `openssl rand -base64 48`.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000

# --- Browser origins allowed to call this API ---
# Comma-separated. Leave unset locally to reflect any origin; ALWAYS set it in
# production, or any website can call the API with a stolen token.
# CORS_ORIGINS="https://your-frontend.vercel.app"

# --- File storage ---
# Set automatically by Vercel when a Blob store is connected to the project.
# When present, uploads and backups go to Blob instead of the local disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Scheduled jobs ---
# Required in production. Vercel Cron sends this as `Authorization: Bearer ...`
# when calling /api/cron/*. Without it those endpoints refuse every request.
# Generate with: openssl rand -hex 32
# CRON_SECRET="..."

# --- Seeding ---
# The admin account created by `npx prisma db seed`.
# Leave SEED_ADMIN_PASSWORD unset and the seed generates a random password and
# prints it once. Setting it here also RESETS the password of an existing admin
# on the next seed run, so leave it blank unless that is what you want.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=

# --- Mail (optional) ---
# Without these, mail sending is skipped rather than failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Solar Store <no-reply@example.com>"
