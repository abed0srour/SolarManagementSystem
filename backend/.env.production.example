# ==============================================================================
# Solar Store Backend - Production Environment Template (.env.production)
# ==============================================================================
# Set these variables in your Production Hosting environment (e.g. Vercel Production)
# and in GitHub Actions Secrets for Production release pipelines.
#
# IMPORTANT: Never reuse Staging credentials or database instances in Production!

NODE_ENV="production"
PORT=3000

# --- Database Connections (Production Supabase Project) ---
# Pooled connection via PgBouncer (port 6543) - used by serverless runtime
DATABASE_URL="postgresql://postgres.<prod_ref>:<prod_db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) - required for Prisma & Supabase schema migrations
DIRECT_URL="postgresql://postgres.<prod_ref>:<prod_db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Production Project) ---
SUPABASE_URL="https://<prod_ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<prod_supabase_service_role_key>"
# Omit SUPABASE_JWT_SECRET if Production Supabase project uses standard asymmetric JWKS verification:
# SUPABASE_JWT_SECRET="<prod_legacy_jwt_secret_if_applicable>"

# --- Application Routing & Security ---
# URL of the Live Next.js Production Frontend
APP_URL="https://solarstore.example.com"

# Generate cryptographically secure production keys:
# `openssl rand -base64 48` for JWT_SECRET
# `openssl rand -hex 32` for CRON_SECRET
# NOTE: Changing JWT_SECRET invalidates existing customer receipt pickup QR codes!
JWT_SECRET="<production_cryptographically_secure_random_key>"
CRON_SECRET="<production_cryptographically_secure_cron_secret>"

# Whitelist Production Frontend Domains
CORS_ORIGINS="https://solarstore.example.com,https://app.solarstore.example.com"

# --- Production File Storage ---
# Production Vercel Blob store for uploads and encrypted database backup snapshots
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<production_blob_token>"

# --- Production Email Notifications (Amazon SES / SendGrid / Postmark / Resend) ---
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<prod_smtp_user>"
SMTP_PASS="<prod_smtp_pass>"
MAIL_FROM="Solar Store <noreply@solarstore.example.com>"
